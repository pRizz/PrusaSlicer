load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/deps:proof_slice_deps.bzl", "PROOF_SLICE_COPTS")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "config_test",
    srcs = [
        "BazelCatchMain.cpp",
        "test_config.cpp",
    ],
    copts = PROOF_SLICE_COPTS + [
        "-DTEST_DATA_DIR=\\\"tests/data\\\"",
    ],
    local_defines = [
        "CATCH_CONFIG_FAST_COMPILE",
    ],
    deps = [
        "//deps/build/destdir/usr/local/include:catch2_headers",
        "//src/libslic3r:config_core",
    ] + select({
        "//tools/bazel/platforms:is_linux": [
            "//deps/build/destdir/usr/local/lib:proof_slice_linux_catch2",
        ],
        "//conditions:default": [
            "//deps/build/destdir/usr/local/lib:catch2",
        ],
    }),
    data = ["//tests:test_data"],
    linkopts = [],
)
