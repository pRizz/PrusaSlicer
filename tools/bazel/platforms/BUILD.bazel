package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_linux",
    constraint_values = [
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

# Phase 3 wave 1 note:
# Keep macOS as the first proving ground without creating a separate target
# namespace. The same labels must later work on Linux.
#
# Linux note:
# Native Linux CI now uses the x86_64 platform above. The macOS-hosted Docker
# proof continues to use a Linux/arm64 target platform so the same public
# labels can still be exercised from the available local arm64 host.

# Reserved for later phases. Do not wire active Windows behavior here yet.
platform(
    name = "windows_future",
    constraint_values = [
        "@platforms//os:windows",
    ],
)
