load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "vendor_headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
        "**/*.ipp",
        "eigen3/Eigen/**",
        "eigen3/unsupported/**",
    ]),
    includes = [
        ".",
        "eigen3",
        "LibBGCode",
    ],
)

cc_library(
    name = "catch2_headers",
    hdrs = glob([
        "catch2/**/*.hpp",
    ]),
    includes = ["."],
)
