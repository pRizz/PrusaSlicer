#!/usr/bin/env bash
set -euo pipefail

readonly BAZEL_TEST_SUITE="//tools/bazel:test_suite"
readonly BAZEL_BUILD_TARGET="//src:PrusaSlicer"
readonly BAZEL_LINUX_NATIVE_CONFIG="linux"
readonly BAZEL_LINUX_DOCKER_CONFIG="linux_arm64"

set_bazel_prefix() {
  if command -v bazelisk >/dev/null 2>&1; then
    BAZEL_PREFIX=(bazelisk)
    return
  fi

  if command -v bazel >/dev/null 2>&1; then
    BAZEL_PREFIX=(bazel)
    return
  fi

  if command -v npx >/dev/null 2>&1; then
    BAZEL_PREFIX=(npx -y @bazel/bazelisk)
    return
  fi

  BAZEL_PREFIX=(bazelisk)
}

usage() {
  cat <<'EOF'
PrusaSlicer Bazel front door

Usage:
  ./prusa <command> [--platform linux|macos] [--dry-run|--print-command]

Commands:
  build    Run the authoritative Bazel Phase 5 product build target
  test     Run the bounded Bazel Phase 4 test suite
  fmt      Run bounded Bazel-backed formatting checks or fixes
  lint     Run the bounded Bazel Phase 4 lint pass
  compdb   Refresh bounded Bazel compile commands for clangd
  help     Show this help

Examples:
  ./prusa build --dry-run
  ./prusa test --platform macos --dry-run
  ./prusa test --platform linux --dry-run
  ./prusa fmt --check --dry-run
  ./prusa fmt --fix --dry-run
  ./prusa compdb --dry-run

Direct Bazel equivalents:
  build  -> bazel build --config=dev --config=<resolved-platform> //src:PrusaSlicer
  test   -> bazel test --config=dev --config=<resolved-platform> //tools/bazel:test_suite
  fmt    -> bazel run --config=dev //tools/bazel/format:<check|fix>
  lint   -> bazel run --config=dev //tools/bazel/lint:clang_tidy
  compdb -> bazel run --config=dev --config=compdb //tools/bazel/compdb:refresh

Notes:
  - Bazel is the repo-root front door for the migration work.
  - Optional repo-root `just` recipes mirror these commands for convenience only.
  - `build` is the authoritative bounded product build target for the current Bazel slice.
  - `test` is the bounded non-GUI local test surface for Phase 4, not full legacy CTest parity.
  - `fmt` currently covers the Bazel-owned proof slice and adjacent non-GUI tests, not the whole repo.
  - `lint` currently uses clang-tidy on the Bazel-owned proof slice and adjacent non-GUI tests only.
  - `compdb` writes to build/compdb/compile_commands.json for clangd and other editor tooling.
  - On Linux hosts, `--platform linux` uses the native x86_64 Bazel config.
  - On macOS, `--platform linux` runs the same labels inside Docker using the Linux arm64 Bazel config.
  - Legacy CMake build docs remain available during the transition.
  - Platform configs are centralized under //tools/bazel/platforms.
  - System-library exceptions are centralized under tools/bazel/policies/system_libraries.bzl.
EOF
}

workspace_root() {
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd
}

platform_config() {
  case "$(uname -s)" in
    Linux)
      printf '%s' "linux"
      ;;
    Darwin)
      printf '%s' "macos"
      ;;
    *)
      printf '%s' "linux"
      ;;
  esac
}

run_linux_test_via_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'Docker is required to run the Linux Bazel test suite from macOS.\n' >&2
    exit 1
  fi

  local repo_root
  repo_root="$(workspace_root)"

  docker run --rm --platform=linux/arm64 --user 0:0 -v "${repo_root}:/workspace" -w /workspace ubuntu:24.04 bash -lc '
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update >/dev/null
apt-get install -y ca-certificates curl git unzip zip openjdk-21-jdk build-essential python3 pkg-config cmake ninja-build libboost-all-dev libtbb-dev libexpat1-dev libpng-dev catch2 >/dev/null
curl -fsSL -o /usr/local/bin/bazelisk https://github.com/bazelbuild/bazelisk/releases/download/v1.22.0/bazelisk-linux-arm64
chmod +x /usr/local/bin/bazelisk
mkdir -p /tmp/codex-home /tmp/bazelroot
HOME=/tmp/codex-home bazelisk --output_user_root=/tmp/bazelroot test --config=dev --config=linux_arm64 //tools/bazel:test_suite
'
}

run_linux_build_via_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'Docker is required to run the Linux Bazel build from macOS.\n' >&2
    exit 1
  fi

  local repo_root
  repo_root="$(workspace_root)"

  docker run --rm --platform=linux/arm64 --user 0:0 -v "${repo_root}:/workspace" -w /workspace ubuntu:24.04 bash -lc '
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update >/dev/null
apt-get install -y ca-certificates curl git unzip zip openjdk-21-jdk build-essential python3 pkg-config cmake ninja-build libboost-all-dev libtbb-dev libexpat1-dev libpng-dev catch2 >/dev/null
curl -fsSL -o /usr/local/bin/bazelisk https://github.com/bazelbuild/bazelisk/releases/download/v1.22.0/bazelisk-linux-arm64
chmod +x /usr/local/bin/bazelisk
mkdir -p /tmp/codex-home /tmp/bazelroot
HOME=/tmp/codex-home bazelisk --output_user_root=/tmp/bazelroot build --config=dev --config=linux_arm64 //src:PrusaSlicer
'
}

main() {
  local maybe_command="${1:-help}"
  local dry_run="false"
  local platform
  local fmt_mode="check"
  local bazel_platform_config

  shift || true

  platform="$(platform_config)"
  bazel_platform_config="${platform}"

  while (($#)); do
    case "$1" in
      --platform)
        if (($# < 2)); then
          printf 'Missing value for --platform\n' >&2
          exit 1
        fi
        platform="$2"
        shift
        ;;
      --dry-run|--print-command)
        dry_run="true"
        ;;
      --check)
        if [[ "${maybe_command}" != "fmt" ]]; then
          printf 'Unsupported flag for %s: %s\n' "${maybe_command}" "$1" >&2
          exit 1
        fi
        fmt_mode="check"
        ;;
      --fix)
        if [[ "${maybe_command}" != "fmt" ]]; then
          printf 'Unsupported flag for %s: %s\n' "${maybe_command}" "$1" >&2
          exit 1
        fi
        fmt_mode="fix"
        ;;
      *)
        printf 'Unknown argument: %s\n' "$1" >&2
        exit 1
        ;;
    esac
    shift
  done

  local -a BAZEL_PREFIX
  set_bazel_prefix
  local -a cmd

  if [[ "${platform}" == "linux" && "$(uname -s)" == "Darwin" ]]; then
    bazel_platform_config="${BAZEL_LINUX_DOCKER_CONFIG}"
  elif [[ "${platform}" == "linux" ]]; then
    bazel_platform_config="${BAZEL_LINUX_NATIVE_CONFIG}"
  fi

  case "${maybe_command}" in
    build)
      cmd=("${BAZEL_PREFIX[@]}" build --config=dev --config="${bazel_platform_config}" "${BAZEL_BUILD_TARGET}")
      ;;
    test)
      cmd=("${BAZEL_PREFIX[@]}" test --config=dev --config="${bazel_platform_config}" "${BAZEL_TEST_SUITE}")
      ;;
    fmt)
      cmd=("${BAZEL_PREFIX[@]}" run --config=dev "//tools/bazel/format:${fmt_mode}")
      ;;
    lint)
      cmd=("${BAZEL_PREFIX[@]}" run --config=dev //tools/bazel/lint:clang_tidy)
      ;;
    compdb)
      cmd=("${BAZEL_PREFIX[@]}" run --config=dev --config=compdb //tools/bazel/compdb:refresh)
      ;;
    help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown command: %s\n\n' "${maybe_command}" >&2
      usage >&2
      exit 1
      ;;
  esac

  if [[ "${dry_run}" == "true" ]]; then
    printf 'Direct Bazel equivalent:\n'
    printf '  %q' "${cmd[0]}"
    local idx
    for ((idx = 1; idx < ${#cmd[@]}; idx++)); do
      printf ' %q' "${cmd[idx]}"
    done
    printf '\n'
    if [[ "${maybe_command}" == "build" && "${platform}" == "linux" && "$(uname -s)" == "Darwin" ]]; then
      printf 'Host note:\n'
      printf '  On macOS, this build executes inside Docker using --config=%s.\n' "${BAZEL_LINUX_DOCKER_CONFIG}"
    fi
    if [[ "${maybe_command}" == "test" && "${platform}" == "linux" && "$(uname -s)" == "Darwin" ]]; then
      printf 'Host note:\n'
      printf '  On macOS, this suite executes inside Docker using --config=%s.\n' "${BAZEL_LINUX_DOCKER_CONFIG}"
    fi
    if [[ "${maybe_command}" == "build" && "${platform}" == "linux" && "$(uname -s)" == "Linux" ]]; then
      printf 'Host note:\n'
      printf '  On Linux, this build executes natively using --config=%s.\n' "${BAZEL_LINUX_NATIVE_CONFIG}"
    fi
    if [[ "${maybe_command}" == "test" && "${platform}" == "linux" && "$(uname -s)" == "Linux" ]]; then
      printf 'Host note:\n'
      printf '  On Linux, this suite executes natively using --config=%s.\n' "${BAZEL_LINUX_NATIVE_CONFIG}"
    fi
    exit 0
  fi

  if [[ "${maybe_command}" == "build" && "${platform}" == "linux" && "$(uname -s)" == "Darwin" ]]; then
    run_linux_build_via_docker
    exit 0
  fi

  if [[ "${maybe_command}" == "test" && "${platform}" == "linux" && "$(uname -s)" == "Darwin" ]]; then
    run_linux_test_via_docker
    exit 0
  fi

  exec "${cmd[@]}"
}

main "$@"
