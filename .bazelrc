common --enable_bzlmod

# Shared developer defaults for the Phase 2 Bazel-first skeleton.
common:dev --announce_rc

# Centralized platform names consumed by ./prusa.
# Phase 3 currently proves Linux through a Linux/arm64 environment so the
# shared proof-slice labels can be validated from the available macOS host.
build:linux --platforms=//tools/bazel/platforms:linux
test:linux --platforms=//tools/bazel/platforms:linux
build:macos --platforms=//tools/bazel/platforms:macos
test:macos --platforms=//tools/bazel/platforms:macos

# Placeholder compile-database config. Phase 4 will wire the real tool.
build:compdb --remote_download_outputs=toplevel
run:compdb --remote_download_outputs=toplevel
